from pathlib import Path



class ScreenObject:
    def exists(self) -> bool: ...

    def tap(self) -> bool: ...
    
    def tap_nth(self, n: int) -> bool: ...
    
    def count(self) -> int: ...

    def spam_tap(self, n: int, interval: float) -> bool: ...
    
    def calibrate(self, fixed: bool=False, region: str | None=None) -> None: ...

def get_objects(samples_dir: Path, regions_dir: Path | None = None) -> dict[str, ScreenObject]: ...


class ScreenRegion:
    def calibrate(self) -> None: ...

def get_regions(regions_dir: Path) -> dict[str, ScreenRegion]: ...

def device_config(adb: Path, ip: str | None) -> None: ...

def reset_screen() -> None: ...

def screenshot() -> None: ...

def back() -> None: ...
