from pathlib import Path
from typing import ClassVar

class Direction:
    Left: ClassVar[Direction]
    Right: ClassVar[Direction]
    Up: ClassVar[Direction]
    Down: ClassVar[Direction]

class SwipeSpeed:
    Slow: ClassVar[SwipeSpeed]
    Normal: ClassVar[SwipeSpeed]
    Fast: ClassVar[SwipeSpeed]
    Turbo: ClassVar[SwipeSpeed]

class DeviceObject:
    @property
    def name(self) -> str: ...

    def calibrate(
        self,
        fixed: bool = False,
        region: str | None = None,
        n: int | None = None,
    ) -> None: ...
    def exists(self) -> bool: ...
    def wait(self, timeout: float = 60.0) -> bool: ...
    def force_wait(self, timeout: float = 60.0) -> None: ...
    def tap(self) -> bool: ...
    def force_tap(self) -> None: ...
    def spam_tap(self, n: int, interval: float) -> bool: ...
    def force_spam_tap(self, n: int, interval: float) -> None: ...
    def waitap(self, timeout: float = 60.0) -> bool: ...
    def force_waitap(self, timeout: float = 60.0) -> None: ...
    def swipe(self, dir: Direction, speed: SwipeSpeed, duration: float) -> bool: ...
    def force_swipe(self, dir: Direction, speed: SwipeSpeed, duration: float) -> None: ...
    def tap_nth(self, n: int) -> bool: ...
    def force_tap_nth(self, n: int) -> None: ...
    def tap_each(self) -> None: ...
    def count(self) -> int: ...

class Device:
    def __getitem__(self, name: str) -> DeviceObject: ...
    def calibrate(
        self,
        name: str,
        fixed: bool,
        region: str | None,
        n: int | None,
    ) -> None: ...
    def calibrate_region(self, name: str) -> None: ...
    def exists(self, name: str) -> bool: ...
    def wait(self, name: str, timeout: float = 60.0) -> bool: ...
    def force_wait(self, name: str, timeout: float = 60.0) -> None: ...
    def tap(self, name: str) -> bool: ...
    def force_tap(self, name: str) -> None: ...
    def spam_tap(self, name: str, n: int, interval: float) -> bool: ...
    def force_spam_tap(self, name: str, n: int, interval: float) -> None: ...
    def waitap(self, name: str, timeout: float = 60.0) -> bool: ...
    def force_waitap(self, name: str, timeout: float = 60.0) -> None: ...
    def swipe(
        self,
        name: str,
        dir: Direction,
        speed: SwipeSpeed,
        duration: float,
    ) -> bool: ...
    def force_swipe(
        self,
        name: str,
        dir: Direction,
        speed: SwipeSpeed,
        duration: float,
    ) -> None: ...
    def tap_nth(self, name: str, n: int) -> bool: ...
    def force_tap_nth(self, name: str, n: int) -> None: ...
    def tap_each(self, name: str) -> None: ...
    def count(self, name: str) -> int: ...
    def tap_center(self) -> None: ...
    def swipe_center(self, dir: Direction, speed: SwipeSpeed, duration: float) -> None: ...
    def start_app(self) -> None: ...
    def close_app(self) -> None: ...
    def back(self) -> None: ...
    def home(self) -> None: ...
    def reset_screen(self) -> None: ...
    def save_screen(self) -> None: ...

def get_devices(adb: Path = Path("adb"), app: str | None = None) -> list[Device]: ...

def config_objects(objects_dir: Path, regions_dir: Path | None = None) -> None: ...
def config_regions(regions_dir: Path) -> None: ...
