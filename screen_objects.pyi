from collections.abc import Sequence
from pathlib import Path
from enum import Enum, auto

class Direction(Enum):
    Left = auto()
    Right = auto()
    Down = auto()
    Up = auto()

class SwipeSpeed(Enum):
    Slow = auto()
    Normal = auto()
    Fast = auto()
    Turbo = auto()

class ScreenObject:
    def exists(self) -> bool: ...

    def tap(self) -> bool: ...

    def waitap(self, timeout: float=60.0) -> bool: ...

    def swipe(self, dir: Direction, speed: SwipeSpeed, duration: float) -> bool: ...
    
    def tap_nth(self, n: int) -> bool: ...
    
    def count(self) -> int: ...

    def tap_each(self) -> None: ...

    def spam_tap(self, n: int, interval: float) -> bool: ...

    def wait(self, timeout: float=60.0) -> bool: ...
    
    def calibrate(self, fixed: bool=False, region: str | None=None, n: int | None=None) -> None: ...

    def debug(self, point: Sequence[int]) -> None: ...

def get_objects(objects_dir: Path, regions_dir: Path | None = None) -> dict[str, ScreenObject]: ...

class ScreenRegion:
    def calibrate(self) -> None: ...

def get_regions(regions_dir: Path) -> dict[str, ScreenRegion]: ...

def device_config(
    adb: Path = Path("adb"),
    ip: str | None = None,
    app: str | None = None,
) -> None: ...

def start_app() -> None: ...

def close_app() -> None: ...

def reset_screen() -> None: ...

def tap_center() -> None: ...

def swipe_center(dir: Direction, speed: SwipeSpeed, duration: float) -> None: ...

def screenshot() -> None: ...

def back() -> None: ...

def home() -> None: ...
